# ============================================================================
# AI Chat Assistant Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# The .env file should NOT be committed to version control
# ============================================================================

# ----------------------------------------------------------------------------
# Google AI API Configuration
# ----------------------------------------------------------------------------

# Your Google API Key for accessing Gemini AI models
# Required: Yes
# How to get: Visit https://makersuite.google.com/app/apikey
# Security: Keep this secret and never share it or commit it to version control
# Usage: Used to authenticate requests to Google's Gemini API
GOOGLE_API_KEY=your_google_api_key_here

# ----------------------------------------------------------------------------
# Optional Configuration (for future use)
# ----------------------------------------------------------------------------

# Gemini Model Selection
# Optional: No (defaults to gemini-2.0-flash-exp)
# Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
# Usage: Specify which Gemini model to use for responses
# GEMINI_MODEL=gemini-2.0-flash-exp

# Application Port
# Optional: No (defaults to 8501)
# Usage: Port on which Streamlit application will run
# STREAMLIT_PORT=8501

# Logging Level
# Optional: No (defaults to INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Usage: Control the verbosity of application logging
# LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# - After copying this file to .env, replace 'your_google_api_key_here' with
#   your actual Google API key
# - Never commit the .env file to version control
# - Keep your API keys secure and rotate them periodically
# - For production deployments, consider using a secure secrets manager
# ============================================================================
